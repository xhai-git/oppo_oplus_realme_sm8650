name: 获取 6.1.141 内核 .config 和 Module.symvers

env:
  TZ: Asia/Shanghai
  ANDROID_VERSION: android14
  KERNEL_VERSION: "6.1"
  SUB_VERSION: "141"

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    permissions:
      contents: read

    steps:

      # ============================================================
      # 1. 安装依赖
      # ============================================================
      - name: 安装编译依赖
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            aria2 \
            unzip \
            python-is-python3 \
            libssl-dev \
            libelf-dev \
            bc \
            bison \
            flex \
            ccache

      # ============================================================
      # 2. 下载原版内核源码
      # ============================================================
      - name: 下载原版 SM8650 6.1.141 内核源码
        run: |
          mkdir -p kernel_workspace
          cd kernel_workspace

          aria2c -s16 -x16 -k1M \
            https://github.com/cctv18/android_kernel_common_oneplus_sm8650/archive/refs/heads/oneplus/sm8650_b_16.0.0_oneplus12_6.1.141.zip \
            -o common.zip

          unzip -q common.zip

          mv \
            android_kernel_common_oneplus_sm8650-oneplus-sm8650_b_16.0.0_oneplus12_6.1.141 \
            common

          rm -f common.zip

      # ============================================================
      # 3. 下载 LLVM / Clang 20
      # ============================================================
      - name: 下载 LLVM Clang 20
        run: |
          cd kernel_workspace

          mkdir -p clang20

          aria2c -s16 -x16 -k1M \
            https://github.com/cctv18/oneplus_sm8650_toolchain/releases/download/LLVM-Clang20-r547379/clang-r547379.zip \
            -o clang.zip

          unzip -q clang.zip -d clang20
          rm -f clang.zip

      # ============================================================
      # 4. 配置原版 gki_defconfig
      # ============================================================
      - name: 生成原版 .config
        run: |
          export PATH="$GITHUB_WORKSPACE/kernel_workspace/clang20/bin:$PATH"

          cd kernel_workspace/common

          make \
            -j$(nproc) \
            LLVM=1 \
            ARCH=arm64 \
            CROSS_COMPILE=aarch64-linux-gnu- \
            O=out \
            gki_defconfig

      # ============================================================
      # 5. 准备外部模块编译环境
      # ============================================================
      - name: modules_prepare
        run: |
          export PATH="$GITHUB_WORKSPACE/kernel_workspace/clang20/bin:$PATH"

          cd kernel_workspace/common

          make \
            -j$(nproc) \
            LLVM=1 \
            ARCH=arm64 \
            CROSS_COMPILE=aarch64-linux-gnu- \
            O=out \
            modules_prepare

      # ============================================================
      # 6. 完整构建以生成正确的 Module.symvers
      #
      # 注意：
      # 这里不打包 Image，也不发布内核。
      # 但需要完成 kernel build，才能得到完整 Module.symvers。
      # ============================================================
      - name: 生成 Module.symvers
        run: |
          export PATH="$GITHUB_WORKSPACE/kernel_workspace/clang20/bin:$PATH"

          cd kernel_workspace/common

          make \
            -j$(nproc) \
            LLVM=1 \
            ARCH=arm64 \
            CROSS_COMPILE=aarch64-linux-gnu- \
            O=out

      # ============================================================
      # 7. 检查结果
      # ============================================================
      - name: 检查 .config 和 Module.symvers
        run: |
          cd kernel_workspace/common

          echo "========================================"
          echo ".config"
          echo "========================================"
          ls -lh out/.config

          echo
          echo "========================================"
          echo "Module.symvers"
          echo "========================================"
          ls -lh out/Module.symvers

          echo
          echo "========================================"
          echo "CONFIG_MODVERSIONS"
          echo "========================================"
          grep '^CONFIG_MODVERSIONS=' out/.config || true

          echo
          echo "========================================"
          echo "Module.symvers 行数"
          echo "========================================"
          wc -l out/Module.symvers

      # ============================================================
      # 8. 打包两个文件
      # ============================================================
      - name: 打包 .config 和 Module.symvers
        run: |
          cd kernel_workspace/common/out

          mkdir -p export

          cp .config export/.config
          cp Module.symvers export/Module.symvers

          cd export

          zip -9 \
            ../../../kernel-config-symvers.zip \
            .config \
            Module.symvers

      # ============================================================
      # 9. 上传 Artifact
      # ============================================================
      - name: 上传 .config 和 Module.symvers
        uses: actions/upload-artifact@v7
        with:
          name: kernel-config-symvers
          path: kernel-config-symvers.zip
          archive: false
